<Window x:Class="Koko.DebugUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koko.DebugUI"
        mc:Ignorable="d"
        Title="Koko Debug UI" Height="720" Width="1180">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="LTFS Debug" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="DarkSlateGray" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="Schema" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Button Content="Load Schema File" Click="LoadSchemaFile_Click" Margin="0,0,0,12" Height="32" />

                <Separator Margin="0,4,0,12" />
                <TextBlock Text="Real SCSI Tape" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Button Content="Refresh SCSI Tape Drives" Click="RefreshDrives_Click" Height="32" />
                <Button Content="Show TUR Packet HexDump" Click="ShowTurPacketHexDump_Click" Height="32" Margin="0,0,0,8" />
                <TextBox x:Name="Manual" Margin="0,0,0,8" Height="28" />
                <Button Content="Read Index Partition Schema" Click="ReadIndexPartitionSchema_Click" Height="32" Margin="0,0,0,8" />
                <Button Content="Export LTFS tar.zst" Click="ExportLtfsTarZst_Click" Height="32" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="Reads from the selected real LTO drive using Core LTFS device interfaces. This is non-destructive." />

                <Separator Margin="0,16,0,12" />
                <TextBlock Text="Loaded Index" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="IndexSummaryText" TextWrapping="Wrap" Foreground="DimGray" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Parsed Tree" FontWeight="SemiBold" Margin="10" />
                <TreeView x:Name="SchemaTreeView" Margin="10,0,10,10" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="SCSI Command Details" FontWeight="SemiBold" Margin="10,8,10,4" />
                    <DataGrid x:Name="CommandDetailsGrid"
                              Margin="10,0,0,10"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="150" />
                            <DataGridTextColumn Header="CDB" Binding="{Binding Cdb}" Width="180" />
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="70" />
                            <DataGridTextColumn Header="Len" Binding="{Binding DataLength}" Width="55" />
                            <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="45" />
                            <DataGridTextColumn Header="Status" Binding="{Binding ScsiStatus}" Width="70" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding BytesReturned}" Width="70" />
                            <DataGridTextColumn Header="Transport" Binding="{Binding TransportError}" Width="220" />
                            <DataGridTextColumn Header="Sense" Binding="{Binding Sense}" Width="260" />
                            <DataGridTextColumn Header="Data" Binding="{Binding DataPreview}" Width="520" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,8,10,4" />
                    <TextBox x:Name="LogTextBox" Margin="0,0,10,10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
