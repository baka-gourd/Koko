<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Koko.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Koko"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.DataContext>
            <local:MainWindowViewModel></local:MainWindowViewModel>
        </Grid.DataContext>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="TitleBar"
            IsPaneToggleButtonVisible="False"
            x:Uid="Main_TitleBar"
        >
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Koko.png"></ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>
        <TabView
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsAddTabButtonVisible="False"
            TabItemsSource="{Binding Tabs}"
            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
            TabCloseRequested="TabView_OnTabCloseRequested">

            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="local:TabItemViewModel">
                    <TabViewItem Header="{x:Bind Header}" IsClosable="{x:Bind IsClosable}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <Frame DataContextChanged="TabFrame_DataContextChanged"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               VerticalContentAlignment="Stretch"/>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</Window>
